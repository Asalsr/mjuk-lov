# Mjuk Lov — environment variables
# Local dev: copy to ".env" (gitignored) OR keep your key in spike/.env — both are loaded.
# Production (Vercel): set these in Project → Settings → Environment Variables.

# Required for the AI assistant + recipe adapter (/api/ai) and the author-time
# scripts (npm run label / import / translate).
OPENAI_API_KEY=sk-...

# --- Phase 2: accounts (Supabase) ---
# Until these are set, the auth layer stays dormant and the site runs unchanged.
# From your Supabase project → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY)

# --- Phase 2: payments (Stripe, test mode) — for DIY kit checkout ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # from `stripe listen` locally; Dashboard endpoint in prod
# SUPABASE_SERVICE_ROLE_KEY=...        # SERVER-ONLY secret/service_role key — webhook marks orders paid (bypasses RLS). NEVER NEXT_PUBLIC.
# APP_URL=http://localhost:3000        # base URL Stripe redirects back to after payment

# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# PROVIDER=openai              # set to "claude" to use Anthropic instead of OpenAI
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6
