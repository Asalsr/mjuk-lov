# Mjuk Lov — environment variables
# Local dev: copy to ".env" (gitignored) OR keep your key in spike/.env — both are loaded.
# Production (Vercel): set these in Project → Settings → Environment Variables.

# Required for the AI assistant + recipe adapter (/api/ai) and the author-time
# scripts (npm run label / import / translate).
OPENAI_API_KEY=sk-...

# --- Phase 2: accounts (Supabase) ---
# Until these are set, the auth layer stays dormant and the site runs unchanged.
# From your Supabase project → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# PROVIDER=openai              # set to "claude" to use Anthropic instead of OpenAI
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6
